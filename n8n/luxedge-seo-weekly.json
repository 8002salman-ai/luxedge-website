      "id": "11111111-1111-4111-8111-111111111102",
      "name": "Salman OS — run seo_research",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-780, 200]
    },
    {
      "parameters": {
        "jsCode": "// Take the Hermes research result (keywords array) and expose it as a\n// JSON file for the executor + as JSON for the report.\nconst research = $input.first().json;\n// The research payload can be nested (results[].result.keywords) — flatten\n// defensively so a plain array or an envelope both work.\nlet keywords = research.keywords || research.data?.results?.[0]?.keywords || [];\nif (Array.isArray(research)) keywords = research;\nconst fileText = JSON.stringify(keywords, null, 2);\nreturn {\n  json: { count: keywords.length, keywords },\n  binary: {\n    data: {\n      data: Buffer.from(fileText).toString('base64'),\n      mimeType: 'application/json',\n      fileName: 'weekly-keywords.json'\n    }\n  }\n};"
      },
      "id": "11111111-1111-4111-8111-111111111103",
      "name": "Prepare k.json",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-580, 200]
    },
    {
      "parameters": {
        "fileName": "=C:\\Users\\basco\\Downloads\\luxedge-website\\.freebuff\\weekly-keywords.json",
        "options": {}
      },
      "id": "11111111-1111-4111-8111-111111111104",
      "name": "Write weekly-keywords.json",
      "type": "n8n-nodes-base.writeBinaryFile",
      "typeVersion": 1,
      "position": [-380, 200]
    },
