NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only values. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
GUEST_SESSION_SECRET=

# One-time local admin bootstrap inputs. Keep the password out of Git.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Stripe remains intentionally disabled until Gate 4 test mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Shippo stays server-only. Use a test token until shipping is verified.
SHIPPO_API_TOKEN=
SHIPPO_FROM_NAME=
SHIPPO_FROM_STREET=
SHIPPO_FROM_CITY=
SHIPPO_FROM_STATE=
SHIPPO_FROM_ZIP=
SHIPPO_FROM_COUNTRY=US
SHIPPO_FROM_PHONE=
SHIPPO_FROM_EMAIL=

# Optional integrations; all tokens remain server-only.
RESEND_API_KEY=
OPENROUTER_API_KEY=
HUBSPOT_ACCESS_TOKEN=
