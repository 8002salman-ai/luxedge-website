# ============================================================================
# LUXEDGE V2 — ENVIRONMENT VARIABLES (NAMES ONLY)
#
# These secrets are read ONLY by the serverless functions in /api/*
# (Vercel → Project Settings → Environment Variables). They are NEVER
# bundled into the browser, never stored in localStorage, never committed.
#
# Copy this file to .env for local development, and add the same names (with
# real values) in the Vercel dashboard for production.
# ============================================================================

# AI provider keys (optional — add only the providers you use)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Web scraping token (optional — enables credential-backed AliExpress import
# through the /api/fetch-page endpoint instead of public proxies)
SCRAPE_DO_TOKEN=

# ----------------------------------------------------------------------------
# CJ Dropshipping (Phase 4C — official supplier API, READ/RESEARCH only)
# ----------------------------------------------------------------------------
# Server-only. The Product Scout's Supplier Discovery adapter calls CJ through
# the protected /api/suppliers/cj proxy with the admin JWT; this key is read
# ONLY inside the serverless functions and never reaches the browser.
# Get it from your CJ Dropshipping account (API section).
CJ_API_KEY=

# ----------------------------------------------------------------------------
# Supabase (Phase 3A — real auth + data layer)
# ----------------------------------------------------------------------------
# Public key — safe for the browser (RLS protects the tables). Accepts the
# legacy anon key OR the new publishable key (sb_publishable_...).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only. Never exposed to Vite/browser code. Accepts the legacy
# service_role key OR the new secret key (sb_secret_...). Used by serverless
# functions that need privileged database access.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only (OPTIONAL): the project's JWT signing secret (Dashboard →
# Project Settings → API → JWT Secret). When set, /api/* verifies admin
# access tokens locally (fast). When absent, /api/* validates tokens
# remotely via Supabase's /auth/v1/user endpoint instead — same admin claim
# (app_metadata.role = 'admin'), one extra network call.
# FAIL CLOSED either way: if neither this nor VITE_SUPABASE_* is configured,
# the protected endpoints return 503 and admin auth is disabled.
SUPABASE_JWT_SECRET=
