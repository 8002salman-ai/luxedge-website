# ============================================================================
# LUXEDGE V2 — ENVIRONMENT VARIABLES (NAMES ONLY)
#
# These secrets are read ONLY by the serverless functions in /api/*
# (Vercel → Project Settings → Environment Variables). They are NEVER
# bundled into the browser, never stored in localStorage, never committed.
#
# Copy this file to .env for local development of /api functions, and add
# the same names (with real values) in the Vercel dashboard for production.
# ============================================================================

# AI provider keys (optional — add only the providers you use)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Web scraping token (optional — enables credential-backed AliExpress import
# through the /api/fetch-page endpoint instead of public proxies)
SCRAPE_DO_TOKEN=

# ----------------------------------------------------------------------------
# Supabase (Phase 3A — real auth + data layer)
# ----------------------------------------------------------------------------
# Public anon key — safe for the browser (RLS protects the tables).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only. Never exposed to Vite/browser code. Used by serverless
# functions that need privileged database access (Phase 3B+ data operations).
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. The project's JWT signing secret (Supabase Dashboard →
# Project Settings → API → JWT Secret). /api/ai/* and /api/fetch-page verify
# the admin's access token with this secret. FAIL CLOSED: if it is missing,
# those endpoints return 503 and admin auth is disabled — they never open up.
SUPABASE_JWT_SECRET=
