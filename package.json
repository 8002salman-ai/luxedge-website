{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:cloudflare": "vite build --mode cloudflare-public",
    "cf:types": "wrangler types",
    "cf:check": "npm run build:cloudflare && wrangler deploy --dry-run --env staging",
    "cf:dev": "npm run build:cloudflare && wrangler dev --env staging",
    "cf:deploy:staging": "npm run build:cloudflare && wrangler deploy --env staging"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@untitledui/icons": "^0.0.22",
    "clsx": "2.1.1",
    "date-fns": "^4.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1",
    "tailwind-merge": "3.4.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.124.0"
  }
}
